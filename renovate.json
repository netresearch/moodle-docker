{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "Moodle release in the Dockerfile, together with the upstream commit the sources are pinned to",
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker/moodle/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG MOODLE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\nARG MOODLE_COMMIT=(?<currentDigest>[a-f0-9]{40})"
      ],
      "autoReplaceStringTemplate": "ARG MOODLE_VERSION={{{newValue}}}\nARG MOODLE_COMMIT={{{newDigest}}}",
      "depNameTemplate": "moodle/moodle",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "Every other place that states the Moodle release: compose defaults, .env.example, CI env, README",
      "customType": "regex",
      "managerFilePatterns": [
        "/^compose\\.yml$/",
        "/^\\.env\\.example$/",
        "/^\\.github/workflows/docker-build\\.yml$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "MOODLE_VERSION(?:=|:-|: \")(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "`MOODLE_VERSION` \\| `(?<currentValue>\\d+\\.\\d+\\.\\d+)`"
      ],
      "depNameTemplate": "moodle/moodle",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Keep all Moodle references in one update, so the Dockerfile pin and the compose defaults never diverge",
      "matchPackageNames": ["moodle/moodle"],
      "groupName": "moodle/moodle"
    },
    {
      "description": "Moodle patch releases merge on their own once the checks pass",
      "matchPackageNames": ["moodle/moodle"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "A new Moodle minor or major release waits for a human: the shared auto-merge workflow skips pull requests carrying this label",
      "matchPackageNames": ["moodle/moodle"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "addLabels": ["deps-no-automerge"]
    },
    {
      "description": "Moodle 5.3 supports PHP 8.3 and 8.4; its PHP policy still lists 8.5 as incomplete and for development only (MDL-84684), and docker-build.yml asserts 8.4. Lift this together with the Moodle release that supports 8.5",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["php"],
      "allowedVersions": "<8.5"
    }
  ]
}
