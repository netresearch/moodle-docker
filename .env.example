# =============================================================================
# Moodle 5.2 Docker Stack Configuration
# =============================================================================

# Project name (used for container and volume prefixes)
COMPOSE_PROJECT_NAME=moodle

# =============================================================================
# Moodle Settings
# =============================================================================

# Moodle version. The sources ship inside the image, so changing this alone is
# not enough - rebuild the image as well:
#   docker compose build --build-arg MOODLE_VERSION=<version> moodle
MOODLE_VERSION=5.2.3

# Full URL to your Moodle site (no trailing slash)
MOODLE_URL=http://localhost

# Set to true if behind SSL-terminating proxy (Traefik, CloudFlare, etc.).
# This sets $CFG->sslproxy: Moodle then treats the connection as https even
# though the proxy speaks http to the container.
SSL_PROXY=false

# Moodle's $CFG->reverseproxy, a separate switch for advanced load balancing
# and port forwarding. It makes Moodle compare each request against wwwroot
# and abort with "reverseproxyabused" when they differ, so leave it off for a
# plain TLS-terminating proxy - that case is SSL_PROXY above.
REVERSE_PROXY=false

# Enable Moodle debug mode (set to true for development)
MOODLE_DEBUG=false

# =============================================================================
# Database Settings
# =============================================================================

# Database type (mariadb or pgsql)
DB_TYPE=mariadb

# Database host (use 'database' for the included MariaDB container)
DB_HOST=database

# Database name
DB_NAME=moodle

# Database user
DB_USER=moodle

# Database password (CHANGE THIS!)
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Database root password (CHANGE THIS!)
DB_ROOT_PASSWORD=CHANGE_ME_SECURE_ROOT_PASSWORD

# Table prefix
DB_PREFIX=mdl_

# =============================================================================
# Valkey (Redis-compatible) Settings
# =============================================================================

# Valkey host
VALKEY_HOST=valkey

# Valkey port
VALKEY_PORT=6379

# Valkey password (CHANGE THIS!)
VALKEY_PASSWORD=CHANGE_ME_SECURE_VALKEY_PASSWORD

# =============================================================================
# Email Settings
# =============================================================================

# SMTP host (use 'mailpit' for development mail catcher)
SMTP_HOST=mailpit

# SMTP port
SMTP_PORT=1025

# No-reply email address
SMTP_NOREPLY=noreply@example.com

# =============================================================================
# Port Configuration
# =============================================================================

# HTTP port
HTTP_PORT=80

# HTTPS port
HTTPS_PORT=443
